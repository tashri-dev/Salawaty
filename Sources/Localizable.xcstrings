{
  "sourceLanguage": "en",
  "strings": {
    "PrayerBar needs your location to calculate prayer times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج PrayerBar إلى موقعك لحساب مواقيت الصلاة بدقة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrayerBar, doğru namaz vakitlerini hesaplamak için konumunuza ihtiyaç duyar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "PrayerBar کو نماز کے درست اوقات معلوم کرنے کے لیے آپ کے مقام کی ضرورت ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PrayerBar a besoin de votre position pour calculer les heures de prière avec précision."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "PrayerBar memerlukan lokasi Anda untuk menghitung waktu salat secara akurat."
          }
        }
      }
    },
    "Allow Location Access": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالوصول إلى الموقع"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum Erişimine İzin Ver"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی کی اجازت دیں"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’accès à la position"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan Akses Lokasi"
          }
        }
      }
    },
    "Enter a city instead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مدينة بدلاً من ذلك"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun yerine bir şehir girin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بجائے شہر درج کریں"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisir une ville à la place"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kota sebagai gantinya"
          }
        }
      }
    },
