    "Couldn't find that place. Try “City, Country”.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على هذا المكان. جرّب “المدينة، الدولة”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yer bulunamadı. “Şehir, Ülke” biçiminde deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مقام نہیں ملا۔ “شہر، ملک” آزمائیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver ce lieu. Essayez « Ville, Pays »."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempat tidak ditemukan. Coba “Kota, Negara”."
          }
        }
      }
    },
