    "Plays occasionally in the background on Eid and during Hajj days — never continuously.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشغَّل أحيانًا في الخلفية في العيد وأثناء أيام الحج — وليس باستمرار أبدًا."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramda ve Hac günlerinde arka planda ara sıra çalar — asla sürekli değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عید کے موقع پر اور حج کے ایام میں کبھی کبھار پس منظر میں چلتا ہے — کبھی مسلسل نہیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se joue occasionnellement en arrière-plan pendant l’Aïd et les jours du Hajj — jamais en continu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diputar sesekali di latar belakang saat Idulfitri/Iduladha dan selama hari-hari Haji — tidak pernah terus-menerus."
          }
        }
      }
    },
