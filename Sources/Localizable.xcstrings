    "City, e.g. Cairo, Egypt": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدينة، مثال: القاهرة، مصر"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir, örn. Kahire, Mısır"
          }
        },
        "ur": {
