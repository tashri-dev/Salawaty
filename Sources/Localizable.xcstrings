    "No adhan recordings yet. Tap “Add Sound…” to import MP3/M4A files of your favourite sheikhs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد تسجيلات أذان بعد. اضغط “إضافة صوت…” لاستيراد ملفات MP3/M4A لمشايخك المفضلين."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz ezan kaydı yok. Sevdiğiniz hafızların MP3/M4A dosyalarını içe aktarmak için “Ses Ekle…” ye dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی تک اذان کی کوئی ریکارڈنگ نہیں۔ اپنے پسندیدہ قاریوں کی MP3/M4A فائلیں درآمد کرنے کے لیے “صوت شامل کریں…” دبائیں۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun enregistrement d’adhan pour l’instant. Appuyez sur « Ajouter un son… » pour importer des fichiers MP3/M4A de vos cheikhs préférés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada rekaman azan. Ketuk “Tambah Suara…” untuk mengimpor file MP3/M4A dari syekh favorit Anda."
          }
        }
      }
    },
