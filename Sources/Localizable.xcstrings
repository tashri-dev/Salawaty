            "value": "Gunakan lokasi Mac ini"
          }
        }
      }
    },
    "Location access is denied — the city below is used instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى الموقع — يُستخدم بدلاً منه المدينة أدناه."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi reddedildi — bunun yerine aşağıdaki şehir kullanılıyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی مسترد کر دی گئی — اس کے بجائے نیچے دیا گیا شہر استعمال ہو رہا ہے۔"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est refusé — la ville ci-dessous est utilisée à la place."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses lokasi ditolak — kota di bawah ini digunakan sebagai gantinya."
          }
        }
      }
    },
